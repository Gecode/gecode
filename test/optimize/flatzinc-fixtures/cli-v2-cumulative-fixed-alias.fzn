% Original alias-domain intersections fix duration=2 and capacity=2; h is assigned.
% Task [-1,1) uses one unit, so the two-unit task has earliest start 1.
var {0,2}: d :: output_var;
var int: duration_alias :: output_var = d;
var 0..3: h :: output_var = 1;
var {1,2}: capacity :: output_var;
var int: capacity_alias :: output_var = capacity;
var -1..3: s :: output_var;
constraint int_in(duration_alias,1..3);
constraint int_in(capacity_alias,{2});
constraint cumulatives([-1,s],[duration_alias,1],[h,2],capacity_alias);
solve minimize s;
