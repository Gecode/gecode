% CLI fixture v1: enumerate x in -2..4 and y in -1..3.
% With x-y <= 2 and z=2*x+y, the unique maximum is (x,y,z)=(4,3,11).
var -2..4: x :: output_var;
var -1..3: y :: output_var;
var -5..11: z :: output_var;
constraint int_lin_eq([2,1,-1],[x,y,z],0);
constraint int_lin_le([1,-1],[x,y],2);
solve maximize z;
