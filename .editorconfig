root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,lxx,yxx,vis}]
indent_size = 4
max_line_length = 120

[*.py]
indent_size = 4

[{CMakeLists.txt,*.cmake,*.yml,*.yaml}]
indent_size = 2
