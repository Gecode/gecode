[General]
Name:           Word
Namespace:      Gecode::Word
Ifdef:          GECODE_HAS_WORD_VARS
Bits:           0
Dispose:        false
[ModEventHeader]
[ModEvent]
Name:           FAILED=FAILED
[ModEvent]
Name:           NONE=NONE
[ModEvent]
Name:           VAL=ASSIGNED
Combine:        VAL=VAL, BITS=VAL, BND=VAL, DOM=VAL
[ModEvent]
Name:           BITS
Combine:        VAL=VAL, BITS=BITS, BND=DOM, DOM=DOM
[ModEvent]
Name:           BND
Combine:        VAL=VAL, BITS=DOM, BND=BND, DOM=DOM
[ModEvent]
Name:           DOM=SUBSCRIBE
Combine:        VAL=VAL, BITS=DOM, BND=DOM, DOM=DOM
[ModEventFooter]
[PropCondHeader]
[PropCond]
Name:           NONE=NONE
[PropCond]
Name:           VAL=ASSIGNED
ScheduledBy:    VAL
[PropCond]
Name:           BITS
ScheduledBy:    VAL, BITS, DOM
[PropCond]
Name:           BND
ScheduledBy:    VAL, BND, DOM
[PropCond]
Name:           DOM
ScheduledBy:    VAL, BITS, BND, DOM
[PropCondFooter]
[End]
