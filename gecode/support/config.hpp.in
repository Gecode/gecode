/* Whether to build with default memory allocator */
#cmakedefine GECODE_ALLOCATOR 1

/* Whether to include audit code */
#cmakedefine GECODE_AUDIT 1

/* User-defined prefix of dll names */
#define GECODE_DLL_USERPREFIX "@GECODE_DLL_USERPREFIX@"

/* User-defined suffix of dll names */
#define GECODE_DLL_USERSUFFIX "@GECODE_DLL_USERSUFFIX@"

/* max freelist size on 32 bit platforms */
#cmakedefine GECODE_FREELIST_SIZE_MAX32 @GECODE_FREELIST_SIZE_MAX32@

/* max freelist size on 64 bit platforms */
#cmakedefine GECODE_FREELIST_SIZE_MAX64 @GECODE_FREELIST_SIZE_MAX64@

/* Whether gcc understands visibility attributes */
#cmakedefine GECODE_GCC_HAS_CLASS_VISIBILITY 1

/* whether __builtin_ffsll is available */
#cmakedefine GECODE_HAS_BUILTIN_FFSLL 1

/* whether __builtin_popcountll is available */
#cmakedefine GECODE_HAS_BUILTIN_POPCOUNTLL 1

/* Whether counting-based search support available */
#cmakedefine GECODE_HAS_CBS 1

/* Whether CPProfiler support available */
#cmakedefine GECODE_HAS_CPPROFILER 1

/* Whether experimental preview APIs are available */
#cmakedefine GECODE_HAS_EXPERIMENTAL 1

/* Whether deterministic test failpoints are enabled */
#cmakedefine GECODE_HAS_FAULT_INJECTION 1

/* Whether to build FLOAT variables */
#cmakedefine GECODE_HAS_FLOAT_VARS 1

/* Whether Gist is available */
#cmakedefine GECODE_HAS_GIST 1

/* Whether to build INT variables */
#cmakedefine GECODE_HAS_INT_VARS 1

/* Whether MPFR is available */
#cmakedefine GECODE_HAS_MPFR 1

/* Whether we have mtrace for memory leak debugging */
#cmakedefine GECODE_HAS_MTRACE 1

/* Whether persistent process blackboxes are supported */
#cmakedefine GECODE_HAS_POSIX_BLACKBOX_EXEC 1

/* Whether posix_spawn_file_actions_addclosefrom_np is available */
#cmakedefine GECODE_HAS_POSIX_SPAWN_ADDCLOSEFROM_NP 1

/* Whether posix_spawn_file_actions_addinherit_np is available */
#cmakedefine GECODE_HAS_POSIX_SPAWN_ADDINHERIT_NP 1

/* Whether POSIX_SPAWN_CLOEXEC_DEFAULT is available */
#cmakedefine GECODE_HAS_POSIX_SPAWN_CLOEXEC_DEFAULT 1

/* Whether Qt is available */
#cmakedefine GECODE_HAS_QT 1

/* Whether to build SET variables */
#cmakedefine GECODE_HAS_SET_VARS 1

/* Whether we are compiling with thread support */
#cmakedefine GECODE_HAS_THREADS 1

/* Gecode version */
#define GECODE_LIBRARY_VERSION "@GECODE_LIBRARY_VERSION@"

/* Heap memory alignment */
#cmakedefine GECODE_MEMORY_ALIGNMENT @GECODE_MEMORY_ALIGNMENT@

/* Use the private mimalloc backend. */
#cmakedefine GECODE_MIMALLOC 1

/* How to check allocation size */
#cmakedefine GECODE_MSIZE @GECODE_MSIZE@

/* Whether legacy MSVC automatic library selection is disabled. */
#cmakedefine GECODE_NO_AUTOLINK 1

/* Whether to track peak heap size */
#cmakedefine GECODE_PEAKHEAP 1

/* Whether we need malloc.h */
#cmakedefine GECODE_PEAKHEAP_MALLOC_H 1

/* Whether we need malloc/malloc.h */
#cmakedefine GECODE_PEAKHEAP_MALLOC_MALLOC_H 1

/* Whether we are compiling static libraries */
#cmakedefine GECODE_STATIC_LIBS 1

/* Whether to use unfair mutexes on macOS */
#cmakedefine GECODE_USE_OSX_UNFAIR_MUTEX 1

/* Gecode version */
#define GECODE_VERSION "@GECODE_VERSION@"

/* Gecode version */
#define GECODE_VERSION_NUMBER @GECODE_VERSION_NUMBER@

/* Define to 1 if you have a working `mmap' system call. */
#cmakedefine HAVE_MMAP 1

/* How to tell the compiler to really, really inline */
#if defined(_MSC_VER)
#define forceinline __forceinline
#else
#define forceinline inline __attribute__ ((__always_inline__))
#endif

// STATISTICS: support-any
