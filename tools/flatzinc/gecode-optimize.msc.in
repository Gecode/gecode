{
  "id": "org.gecode.optimize.experimental",
  "name": "Gecode Optimize (experimental)",
  "version": "@GECODE_VERSION@",
  "mznlib": "@GECODE_OPTIMIZE_MSC_MZNLIB@",
  "executable": ["@GECODE_OPTIMIZE_MSC_EXECUTABLE@", "--minizinc"],
  "tags": ["cp", "int", "experimental"],
  "stdFlags": ["-t"],
  "extraFlags": [
    ["--native-mode", "Native exact strategy: auto policy, bounded race, ordinary BAB, or explicitly configured search; racing may increase total CPU work or solve time", "opt:auto:race:plain:configured", "auto"],
    ["--native-auto-presolve", "Enable bounded exact presolve in auto/race mode", "opt:on:off", "on"],
    ["--native-auto-components", "Enable independent component solving in auto/race mode", "opt:on:off", "on"],
    ["--native-auto-symmetry", "Enable identical-column symmetry breaking in auto/race mode", "opt:on:off", "on"],
    ["--native-auto-knapsack", "Enable eligible exact knapsack dynamic programming in auto/race mode", "opt:on:off", "on"],
    ["--native-race-seconds", "Maximum total sequential exploration seconds in race mode (0 skips racing); exploration can increase CPU work or solve time", "float", "2"],
    ["--native-race-nodes", "Positive per-probe node limit in race mode; probes share the global solve budget", "int", "4096"],
    ["--native-lp", "Checked LP deductions in configured mode; root or updated requires the checked LP build", "opt:off:root:updated", "off"],
    ["--native-root-cuts", "Enable verified root cover cuts with configured LP deductions", "opt:on:off", "off"],
    ["--native-bound-tightening", "Enable certificate-checked bound tightening with configured LP deductions", "opt:on:off", "on"],
    ["--native-lp-interval", "Positive number of observed bound changes between updated LP attempts", "int", "1"],
    ["--native-search", "Configured search order; bab uses ordinary branch and bound, dfs/best-bound use the bounded frontier", "opt:bab:dfs:best-bound", "dfs"],
    ["--native-branching", "Configured frontier branching policy; reliability probes binary propagation gains", "opt:default:reliability", "default"],
    ["--native-branching-probes", "Maximum reliability probe status attempts; included in the global node budget", "int", "128"],
    ["--native-max-open-nodes", "Configured frontier live-space cap (0 permits no search spaces; this is not a byte limit)", "int", "100000"],
    ["--native-neighborhood", "Configured frontier primal improvement policy; optional Hamming work shares the global solve budget", "opt:off:hamming", "off"],
    ["--native-neighborhood-radius", "Nonnegative binary Hamming distance radius for the optional neighborhood", "int", "1"],
    ["--native-neighborhood-nodes", "Maximum neighborhood status attempts; included in the global node budget", "int", "128"],
    ["--native-neighborhood-seconds", "Maximum optional neighborhood time in seconds; 0 skips its work", "float", "0.05"],
    ["--native-node-limit", "Nonnegative global node budget, shared by search and optional probes (0 permits no node work)", "int", "18446744073709551615"],
    ["--native-diagnostics", "Emit requested strategy, selected native policy and available work counters as FlatZinc comments", "opt:on:off", "off"]
  ],
  "inputType": "FZN",
  "needsSolns2Out": true,
  "needsMznExecutable": false,
  "needsStdlibDir": false,
  "isGUIApplication": false
}
